# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/image_uploads?schema=public"

# Redis (used by BullMQ queue)
REDIS_URL="redis://localhost:6379"

# AWS S3 (or an S3-compatible service, e.g. MinIO — set S3_ENDPOINT + S3_FORCE_PATH_STYLE=true)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
S3_BUCKET=image-upload-system
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# AWS Rekognition (face detection). Uses the same AWS credentials above.
FACE_DETECTION_PROVIDER=rekognition   # "rekognition" | "none" (disables the check)

# Validation thresholds
MIN_WIDTH_PX=400
MIN_HEIGHT_PX=400
MIN_FILE_SIZE_BYTES=10240
MAX_FILE_SIZE_BYTES=20971520
BLUR_VARIANCE_THRESHOLD=100
MIN_FACE_AREA_PCT=5
DUPLICATE_HAMMING_DISTANCE_THRESHOLD=5
